---
const links = [
  {
    label: 'Email',
    href: 'mailto:jonathanolayinka@gmail.com',
    text: 'jonathanolayinka@gmail.com',
    icon: 'M4 6h16v12H4z M4 7l8 6 8-6',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/emmanuel-jonathan1109',
    text: 'linkedin.com/in/emmanuel-jonathan1109',
    icon: 'M4 4h16v16H4z M8 10v6 M8 7.5v.01 M12 16v-6 M12 12.5c0-1.5 1-2.5 2.25-2.5S16 11 16 12.5V16',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/emmyjonny',
    text: 'github.com/emmyjonny',
    icon: 'M9 19c-4 1.5-4-2-6-2.5 M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
  },
  {
    label: 'Website',
    href: 'https://emmyjonny.github.io',
    text: 'emmyjonny.github.io',
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M3 12h18 M12 3c2.5 2.7 2.5 15.3 0 18 M12 3c-2.5 2.7-2.5 15.3 0 18',
  },
];
---

<section id="contact">
  <div class="container">
    <div class="panel">
      <div class="intro">
        <p class="eyebrow">03 · Contact</p>
        <h2>Let's work together.</h2>
        <p>
          I'm always happy to talk about AI governance, risk, compliance or new opportunities.
          Reach out anytime.
        </p>
        <a class="btn btn-primary" href="mailto:jonathanolayinka@gmail.com">Say hello &rarr;</a>
      </div>
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                <span class="icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={link.icon} />
                  </svg>
                </span>
                <span class="text">
                  <span class="label">{link.label}</span>
                  <span class="value">{link.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border-radius: 24px;
    border: 1px solid var(--border);
    background:
      radial-gradient(30rem 20rem at 0% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(26rem 18rem at 100% 100%, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 70%),
      var(--surface);
    box-shadow: var(--shadow);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .intro p:not(.eyebrow) {
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .links a:hover {
    transform: translateX(4px);
    border-color: var(--accent);
  }

  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .value {
    font-weight: 500;
    overflow-wrap: anywhere;
    line-height: 1.4;
  }

  @media (max-width: 820px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
