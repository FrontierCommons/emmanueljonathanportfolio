---
const highlights = ['Law', 'Risk & Compliance', 'AML Investigations', 'Machine Learning'];
---

<section class="hero">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="avatar" aria-hidden="true">EJ</div>
    <p class="eyebrow">AI &amp; Data Governance</p>
    <h1>
      Building AI that is <span class="gradient">accountable</span> by design.
    </h1>
    <p class="lead">
      I'm Emmanuel Jonathan, a law-trained risk and compliance professional moving into AI
      governance, data governance and risk-aware machine learning.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#projects">View my work &rarr;</a>
      <a class="btn btn-secondary" href="#contact">Get in touch</a>
    </div>
    <ul class="highlights">
      {highlights.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
    border-bottom: 1px solid var(--border);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40rem 24rem at 85% -10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(32rem 22rem at -5% 110%, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent 70%);
  }

  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at 50% 40%, #000 20%, transparent 75%);
    opacity: 0.6;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 22px;
    margin-bottom: 1.75rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    box-shadow: var(--shadow-lg);
    transform: rotate(-4deg);
  }

  h1 {
    max-width: 52rem;
    font-size: clamp(2.4rem, 7vw, 4.25rem);
    margin-bottom: 1.25rem;
  }

  .gradient {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    color: var(--muted);
    max-width: 40rem;
    margin: 0 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .highlights li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .highlights li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-2);
  }

  @media (max-width: 560px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }
  }
</style>
