---
const projects = [
  {
    title: 'Project One',
    description:
      'A short description of what this project does, the problem it solves, and what you learned building it.',
    tags: ['Astro', 'TypeScript'],
    link: '#',
  },
  {
    title: 'Project Two',
    description:
      'Another placeholder project. Swap in a real summary, the tools you used, and a link to the code or live demo.',
    tags: ['Node.js', 'CSS'],
    link: '#',
  },
];
---

<section id="projects">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a href={project.link}>View project &rarr;</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .card p {
    color: var(--muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  .card a {
    font-weight: 600;
    text-decoration: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .tags li {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
</style>
