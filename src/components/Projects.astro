---
const projects = [
  {
    title: 'Credit Card Fraud Detection ML System',
    description:
      'A supervised machine learning system that flags fraudulent card transactions in a heavily imbalanced Kaggle dataset. Compares Logistic Regression, Random Forest, XGBoost and a neural network on ROC-AUC, precision, recall and F1, deployed as an interactive Streamlit app with a monitoring dashboard.',
    tags: ['Python', 'pandas', 'scikit-learn', 'XGBoost', 'Streamlit'],
    links: [
      { label: 'Code', href: 'https://github.com/emmyjonny/credit-card-fraud-detection-ml-system' },
      { label: 'Live demo', href: 'https://credit-card-fraud-detection-klcjftpzqjodnnkuvnrynv.streamlit.app' },
    ],
  },
  {
    title: 'Smart Contract Digital Asset Registry',
    description:
      "A Solidity smart contract for registering digital assets, storing their metadata and transferring ownership on Ethereum. Uses OpenZeppelin's Ownable and ReentrancyGuard, checks ownership before transfers, and logs events so every change is visible.",
    tags: ['Solidity', 'Hardhat', 'OpenZeppelin'],
    links: [{ label: 'Code', href: 'https://github.com/emmyjonny/Smart-Contract-Digital-Asset-Registry' }],
  },
  {
    title: 'U.S. Gun Violence Dashboard (2014–2022)',
    description:
      'An interactive Tableau dashboard combining Kaggle incident data with U.S. Census population figures. Per-capita rates allow fair state comparisons, shown through a choropleth map, state rankings, trend lines and an injuries-vs-fatalities breakdown. Includes a written report.',
    tags: ['Tableau', 'Data analysis'],
    links: [{ label: 'Code', href: 'https://github.com/emmyjonny/us-gun-violence-dashboard' }],
  },
  {
    title: 'StudyLoop',
    description:
      'An early prototype of an AI exam-practice platform. A Node.js/Express backend that calls the Claude API to generate multiple-choice practice questions, with answers and explanations, for any subject, topic and difficulty.',
    tags: ['Node.js', 'Express', 'Claude API'],
    links: [{ label: 'Code', href: 'https://github.com/emmyjonny/StudyLoop' }],
  },
  {
    title: 'Intro Solidity Smart Contract',
    description:
      'A beginner contract built in Remix while learning smart contract basics. It stores an input value but caps it at 100.',
    tags: ['Solidity', 'Remix'],
    links: [{ label: 'Code', href: 'https://github.com/emmyjonny/Smart-Contract---Emmanuel-Jonathan' }],
  },
];
---

<section id="projects">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="links">
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label} &rarr;
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .card p {
    color: var(--muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .links a {
    font-weight: 600;
    text-decoration: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .tags li {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
</style>
